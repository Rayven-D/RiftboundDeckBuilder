# Copy to .env and fill in. Never commit .env.
# Riot developer key (server-side only, never in the Angular app)
RIOT_API_KEY=
# americas | europe | asia
RIOT_REGION=americas
# services/ API port
PORT=3000
# Card snapshot folder; empty = <project>/data
DATA_DIR=
# development enables CORS for the Angular dev server (http://localhost:4200)
NODE_ENV=development
