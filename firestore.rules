rules_version = '2';

// ===============================================================
// Rift Builder: Firestore security rules (prototype, locked down)
// ===============================================================
//
// Assumed data model: none yet.
//
// The app does not read or write Firestore yet. Collections and decks
// still live in browser storage (ADR-0006). The planned per-user layout
// (users/{uid}/collection/..., users/{uid}/decks/...) and its sync rules
// get specced first (see the Handoff Board); owner-only rules with field
// validation are written from that spec.
//
// Until then every read and write is denied. The Firebase Admin SDK
// (server or CI) is not affected by these rules.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
